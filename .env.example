# Copia este archivo como .env. Para una cuenta titular nueva, usa su ID de accounts.
# Las cuentas titulares creadas anteriormente conservan sus permisos.
RIWI_OWNER_ACCOUNT_ID=
PORT=8765
RIWI_ORIGIN=http://127.0.0.1:8765
RIWI_DB_PATH=riwi.sqlite
# Cambia a production y configura un origen HTTPS exacto para acceso remoto.
NODE_ENV=development
# El servidor crea avisos si está encendido. 0 desactiva el reloj.
RIWI_SCHEDULER=1
# Opcional. Nombre:etiqueta de un modelo local presente en Ollama.
RIWI_OLLAMA_MODEL=
# Opcional. Instrucciones privadas del tutor para los modelos que llama el servidor.
RIWI_TUTOR_CONTEXT=
RIWI_TUTOR_SKILLS=
# Opcional. Token de servicio web Moodle emitido por Riwi para tu cuenta.
RIWI_MOODLE_TOKEN=
# Variables del despliegue Vercel. Guárdalas como secretos en el proyecto.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=
# Opcional, cliente OAuth web de Google para usar Gemini en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
