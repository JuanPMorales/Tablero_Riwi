{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"const fs = require('node:fs'); fs.mkdirSync('vercel-static', { recursive: true }); fs.writeFileSync('vercel-static/robots.txt', 'User-agent: *\\nDisallow: /\\n')\"",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/*.js": { "includeFiles": "{*.{html,js,mjs,css,svg,woff2},lessons.json,node_modules/{markdown-it,@highlightjs/cdn-assets,skulpt}/**/{*.umd.min.js,highlight.min.js,skulpt.min.js,skulpt-stdlib.js}}", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/tablero?path=/" },
    { "source": "/login", "destination": "/api/tablero?path=/login" },
    { "source": "/login.js", "destination": "/api/tablero?path=/login.js" },
    { "source": "/api/auth/:action", "destination": "/api/tablero?path=/api/auth/:action" },
    { "source": "/google-callback", "destination": "/api/tablero?path=/google-callback" },
    { "source": "/google-callback.js", "destination": "/api/tablero?path=/google-callback.js" },
    { "source": "/api/google/token", "destination": "/api/tablero?path=/api/google/token" },
    { "source": "/riwi-:icon.svg", "destination": "/api/tablero?path=/riwi-:icon.svg" },
    { "source": "/riwi-inter.woff2", "destination": "/api/tablero?path=/riwi-inter.woff2" },
    { "source": "/ui.css", "destination": "/api/tablero?path=/ui.css" },
    { "source": "/ui.js", "destination": "/api/tablero?path=/ui.js" },
    { "source": "/chat-blocks.js", "destination": "/api/tablero?path=/chat-blocks.js" },
    { "source": "/tutor-rules.mjs", "destination": "/api/tablero?path=/tutor-rules.mjs" },
    { "source": "/chat-context.mjs", "destination": "/api/tablero?path=/chat-context.mjs" },
    { "source": "/chat-markdown.js", "destination": "/api/tablero?path=/chat-markdown.js" },
    { "source": "/chat-highlight.js", "destination": "/api/tablero?path=/chat-highlight.js" },
    { "source": "/chat-runner.html", "destination": "/api/tablero?path=/chat-runner.html" },
    { "source": "/chat-python-runner.html", "destination": "/api/tablero?path=/chat-python-runner.html" },
    { "source": "/chat-preview.html", "destination": "/api/tablero?path=/chat-preview.html" },
    { "source": "/health", "destination": "/api/tablero?path=/health" },
    { "source": "/api/state", "destination": "/api/tablero?path=/api/state" },
    { "source": "/api/ticks", "destination": "/api/tablero?path=/api/ticks" },
    { "source": "/api/week/reopen", "destination": "/api/tablero?path=/api/week/reopen" },
    { "source": "/api/notifications", "destination": "/api/tablero?path=/api/notifications" },
    { "source": "/api/history/note", "destination": "/api/tablero?path=/api/history/note" },
    { "source": "/api/import", "destination": "/api/tablero?path=/api/import" },
    { "source": "/api/session", "destination": "/api/tablero?path=/api/session" },
    { "source": "/api/moodle", "destination": "/api/tablero?path=/api/moodle" },
    { "source": "/api/focus", "destination": "/api/tablero?path=/api/focus" },
    { "source": "/api/chat/delete", "destination": "/api/tablero?path=/api/chat/delete" },
    { "source": "/api/chat/:thread*", "destination": "/api/tablero?path=/api/chat/:thread*" },
    { "source": "/api/chat", "destination": "/api/tablero?path=/api/chat" }
  ],
  "crons": [{ "path": "/api/cron", "schedule": "0 10 * * *" }]
}
