{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"const fs = require('node:fs'); fs.mkdirSync('vercel-static', { recursive: true }); fs.writeFileSync('vercel-static/robots.txt', 'User-agent: *\\nDisallow: /\\n')\"",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/*.js": { "includeFiles": "{index.html,login.html,login.js,google-callback.html,google-callback.js,ui.js,ui.css,lessons.json}", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/tablero?path=/" },
    { "source": "/login", "destination": "/api/tablero?path=/login" },
    { "source": "/login.js", "destination": "/api/tablero?path=/login.js" },
    { "source": "/api/auth/:action", "destination": "/api/tablero?path=/api/auth/:action" },
    { "source": "/google-callback", "destination": "/api/tablero?path=/google-callback" },
    { "source": "/google-callback.js", "destination": "/api/tablero?path=/google-callback.js" },
    { "source": "/api/google/token", "destination": "/api/tablero?path=/api/google/token" },
    { "source": "/ui.css", "destination": "/api/tablero?path=/ui.css" },
    { "source": "/ui.js", "destination": "/api/tablero?path=/ui.js" },
    { "source": "/health", "destination": "/api/tablero?path=/health" },
    { "source": "/api/state", "destination": "/api/tablero?path=/api/state" },
    { "source": "/api/ticks", "destination": "/api/tablero?path=/api/ticks" },
    { "source": "/api/import", "destination": "/api/tablero?path=/api/import" },
    { "source": "/api/session", "destination": "/api/tablero?path=/api/session" },
    { "source": "/api/moodle", "destination": "/api/tablero?path=/api/moodle" },
    { "source": "/api/focus", "destination": "/api/tablero?path=/api/focus" },
    { "source": "/api/chat/:thread*", "destination": "/api/tablero?path=/api/chat/:thread*" },
    { "source": "/api/chat", "destination": "/api/tablero?path=/api/chat" }
  ],
  "crons": [{ "path": "/api/cron", "schedule": "0 10 * * *" }]
}
